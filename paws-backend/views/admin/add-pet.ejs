<%- include('../partials/header') %>

<div class="container">
    <h1>Add New Pet</h1>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message" style="display:block; padding:10px; background:#ffe4e4; border-radius:6px; margin-bottom:15px; color:#a00;"><%= error %></div>
    <% } %>

    <form action="/admin/pets/add" method="POST" enctype="multipart/form-data" class="adoption-form">
        <div class="form-group">
            <label>Pet Name:</label>
            <input type="text" name="name" required minlength="2" maxlength="50" placeholder="e.g. Max">
        </div>

        <div class="form-group">
            <label>Breed:</label>
            <input type="text" name="breed" required minlength="2" maxlength="60" placeholder="e.g. Golden Retriever">
        </div>

        <div class="form-group">
            <label>Age:</label>
            <input type="text" name="age" required placeholder="e.g. 2 Years" title="e.g. 2 Years or 6 Months">
        </div>

        <div class="form-group">
            <label>Type:</label>
            <select name="type" required class="custom-select">
                <option value="" disabled selected>Select type</option>
                <option value="dog">Dog</option>
                <option value="cat">Cat</option>
                <option value="rabbit">Rabbit</option>
                <option value="bird">Bird</option>
            </select>
        </div>

        <div class="form-group">
            <label>Description:</label>
            <textarea name="desc" required placeholder="Tell us about this pet..."></textarea>
        </div>

        <div class="form-group">
            <label>Pet Image:</label>
            <input type="file" name="image" accept="image/*">
        </div>

        <div style="display:flex; gap:15px;">
            <button type="submit" class="btn">Add Pet</button>
            <a href="/admin/pets" class="btn" style="background-color:#4f4f4a;">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>