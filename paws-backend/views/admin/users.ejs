<%- include('../partials/header') %>

<div class="container">
    <h1>Manage Users</h1>

    <form method="GET" action="/admin/users" style="margin-bottom:20px; display:flex; gap:10px;">
        <input type="text" name="q" value="<%= q %>" placeholder="Search by name or email..." class="custom-select" style="flex:1;">
        <button type="submit" class="btn">Search</button>
        <% if (q) { %>
            <a href="/admin/users" class="btn" style="background-color:var(--muted-text);">Clear</a>
        <% } %>
    </form>

    <p style="margin-bottom:15px; color:var(--muted-text);">
        Showing <%= users.length %> of <%= total %> user<%= total !== 1 ? 's' : '' %>
        <% if (q) { %> matching "<%= q %>"<% } %>
    </p>

    <% if (users.length === 0) { %>
        <p>No users found.</p>
    <% } else { %>
        <% users.forEach(function(u) { %>
        <div class="pet-card" style="margin-bottom:20px; text-align:left; flex-direction:row; align-items:center; gap:20px;">
            <div style="flex:1;">
                <h3 style="margin-bottom:4px;"><%= u.name %></h3>
                <p style="margin-bottom:2px;"><strong>Email:</strong> <%= u.email %></p>
                <p style="margin-bottom:2px;"><strong>Phone:</strong> <%= u.phone %></p>
                <p style="margin-bottom:2px;">
                    <strong>Role:</strong>
                    <% if (u.type === 'admin') { %>
                        <span style="display:inline-block; padding:2px 10px; border-radius:12px; font-size:0.85rem; font-weight:bold; background-color:var(--accent-color); color:#fff;">admin</span>
                    <% } else { %>
                        <span style="display:inline-block; padding:2px 10px; border-radius:12px; font-size:0.85rem; font-weight:bold; background-color:var(--muted-text); color:#fff;">customer</span>
                    <% } %>
                </p>
                <p style="margin-bottom:0; font-size:0.85rem; color:var(--muted-text);">
                    Joined: <%= u.createdAt.toDateString() %>
                </p>
            </div>

            <div style="display:flex; flex-direction:column; gap:8px; flex-shrink:0;">
                <a href="/admin/users/<%= u._id %>" class="btn">View</a>

                <form action="/admin/users/<%= u._id %>/role" method="POST">
                    <button type="submit" class="btn" style="width:100%; background-color:var(--primary-dark); color:var(--dark-color);">
                        Make <%= u.type === 'admin' ? 'Customer' : 'Admin' %>
                    </button>
                </form>

                <% if (user && user._id.toString() !== u._id.toString()) { %>
                <form action="/admin/users/<%= u._id %>/delete" method="POST"
                      onsubmit="return confirm('Delete <%= u.name %>? This cannot be undone.');">
                    <button type="submit" class="btn" style="width:100%; background-color:var(--error-color);">Delete</button>
                </form>
                <% } %>
            </div>
        </div>
        <% }) %>
    <% } %>

    <% if (totalPages > 1) { %>
    <div style="display:flex; justify-content:center; gap:8px; margin-top:20px; flex-wrap:wrap;">
        <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === page) { %>
                <a href="/admin/users?page=<%= i %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
                   class="btn" style="background-color:var(--primary-dark); color:var(--dark-color);"><%= i %></a>
            <% } else { %>
                <a href="/admin/users?page=<%= i %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
                   class="btn"><%= i %></a>
            <% } %>
        <% } %>
    </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
