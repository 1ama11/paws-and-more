<%- include('../partials/header') %>

<div class="container">
    <h1>Edit Product</h1>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message" style="display:block; padding:10px; background:#ffe4e4; border-radius:6px; margin-bottom:15px; color:#a00;"><%= error %></div>
    <% } %>

    <form action="/admin/products/edit/<%= product._id %>" method="POST" enctype="multipart/form-data" class="adoption-form">
        <input type="hidden" name="oldImage" value="<%= product.image %>">

        <div class="form-group">
            <label>Product Name:</label>
            <input type="text" name="name" required value="<%= product.name %>" minlength="2">
        </div>

        <div class="form-group">
            <label>Description:</label>
            <textarea name="description" required minlength="5"><%= product.description %></textarea>
        </div>

        <div class="form-group">
            <label>Price ($):</label>
            <input type="number" name="price" required min="0.01" step="0.01" value="<%= product.price %>">
        </div>

        <div class="form-group">
            <label>Stock:</label>
            <input type="number" name="stock" required min="0" value="<%= product.stock %>">
        </div>

        <div class="form-group">
            <label>Category:</label>
            <select name="category" required class="custom-select">
                <option value="" disabled>Select category</option>
                <option value="dog"   <%= product.category === 'dog'   ? 'selected' : '' %>>Dog</option>
                <option value="cat"   <%= product.category === 'cat'   ? 'selected' : '' %>>Cat</option>
                <option value="other" <%= product.category === 'other' ? 'selected' : '' %>>Other</option>
            </select>
        </div>

        <div class="form-group">
            <label>Current Image:</label>
            <% if (product.image) { %>
                <img src="/uploads/<%= product.image %>" style="width:100px; border-radius:8px; display:block; margin-bottom:10px;">
            <% } else { %>
                <p style="color:var(--muted-text); margin-bottom:10px;">No image uploaded</p>
            <% } %>
            <label>Upload New Image (optional):</label>
            <input type="file" name="image" accept="image/*">
        </div>

        <div style="display:flex; gap:15px;">
            <button type="submit" class="btn">Save Changes</button>
            <a href="/admin/products" class="btn" style="background-color:#4f4f4a;">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
