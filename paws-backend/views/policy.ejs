<%- include('partials/header', { title: 'Policy', active: 'policy' }) %>

<!-- HERO -->
<section class="hero" style="padding:80px var(--space-xl); text-align:center;">
  <div class="hero-inner">
    <span class="hero-tag">Our Policies 📜</span>
    <h1>Policies & Guidelines</h1>
    <p>Learn more about how we operate, protect your data, and care for our pets and customers.</p>
  </div>
</section>

<!-- POLICIES -->
<section class="section section--light">
  <div class="section-header">
    <h2>Privacy Policy 🔒</h2>
    <p>Your data is safe with us</p>
  </div>
  <div class="card-container">
    <div class="card">
      <p>
        We collect basic information such as your name, email, and orders to improve your experience.
        Your data is never sold and is stored securely.
      </p>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="section-header">
    <h2>Terms & Conditions 📄</h2>
    <p>Rules for using our website</p>
  </div>
  <div class="card-container">
    <div class="card">
      <p>
        By using our website, you agree to our terms. We may update content, prices, or services at any time.
      </p>
    </div>
  </div>
</section>

<section class="section section--light">
  <div class="section-header">
    <h2>Returns & Refunds 🔄</h2>
    <p>Simple and fair policy</p>
  </div>
  <div class="card-container">
    <div class="card">
      <p style="text-align: center;"> 
         orders take 5-7 business days to arrive <br>
        You can return products within 14 days if unused. Refunds are processed within 5–7 business days.
      </p>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="section-header">
    <h2>Adoption Policy 🐾</h2>
    <p>Ensuring pets go to loving homes</p>
  </div>
  <div class="card-container">
    <div class="card">
      <p>
        Adoption requests are reviewed carefully. We may contact you for additional details before approval.
      </p>
    </div>
  </div>
</section>

<!-- FOOTER -->

<%- include('partials/footer') %>
