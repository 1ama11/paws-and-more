<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paws & More 🐾<%= typeof title !== 'undefined' ? ' — ' + title : '' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Lato:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof extraCss !== 'undefined') { %>
    <% extraCss.forEach(function(href){ %><link rel="stylesheet" href="/css/<%= href %>"><% }) %>
  <% } %>
</head>
<body>

  <!-- HEADER -->
  <header>
    <a href="/" class="logo">Paws &amp; More 🐾</a>
    <nav class="main-nav">
      <a href="/"          class="<%= typeof active !== 'undefined' && active === 'home'     ? 'active' : '' %>">Home</a>
      <a href="/shop"      class="<%= typeof active !== 'undefined' && active === 'shop'     ? 'active' : '' %>">Shop</a>
      <a href="/adoption"  class="<%= typeof active !== 'undefined' && active === 'adoption' ? 'active' : '' %>">Adoption</a>
      <a href="/about"     class="<%= typeof active !== 'undefined' && active === 'about'    ? 'active' : '' %>">About</a>
      <a href="/contact"   class="<%= typeof active !== 'undefined' && active === 'contact'  ? 'active' : '' %>">Contact</a>
      <a href="/policy"    class="<%= typeof active !== 'undefined' && active === 'policy'   ? 'active' : '' %>">Policy</a>
    </nav>
    <div style="display:flex;align-items:center;gap:10px;">
      <% if (user) { %>
        <a href="/user/profile" class="btn btn--sm">Hi, <%= user.name.split(' ')[0] %></a>
        <% if (user.type === 'admin') { %>
          <a href="/admin" class="btn btn--sm">Admin</a>
        <% } %>
        <a href="/user/logout" class="btn btn--sm">Logout</a>
      <% } else { %>
        <a href="/user/login"  class="btn btn--sm">Login</a>
        <a href="/user/signup" class="btn btn--sm">Sign Up</a>
      <% } %>
      <a href="/shop#cart" class="nav-cart">🛒 <span class="cart-count" id="nav-cart-count" style="display:none;">0</span></a>
    </div>
  </header>
