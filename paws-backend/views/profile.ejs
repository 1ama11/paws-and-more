<%- include('partials/header', { title: 'My Profile', active: 'profile' }) %>

<div class="container" style="max-width: 700px;">
  <h1>My Profile</h1>

  <% if (message) { %>
    <div class="error-message" style="display:block; padding:10px; background:#e4ffe4; border-radius:6px; margin-bottom:15px; color:#2e7d2e;">
      <%= message %>
    </div>
  <% } %>

  <div class="pet-card" style="text-align:left; margin-bottom:20px;">
    <h3><%= userDoc.name %></h3>
    <p><strong>Email:</strong> <%= userDoc.email %></p>
    <p><strong>Phone:</strong> <%= userDoc.phone %></p>
    <p><strong>Address:</strong> <%= userDoc.address %></p>
    <p><strong>Account Type:</strong> <%= userDoc.type %></p>
    <p><strong>Member Since:</strong> <%= userDoc.createdAt.toDateString() %></p>
  </div>

  <h2>Update Your Info</h2>
  <form action="/user/profile" method="POST" class="adoption-form">
    <div class="form-group">
      <label>Full Name</label>
      <input type="text" name="name" required minlength="3" value="<%= userDoc.name %>">
    </div>
    <div class="form-group">
      <label>Phone Number</label>
      <input type="tel" name="phone" required pattern="\d{11}" value="<%= userDoc.phone %>">
    </div>
    <div class="form-group">
      <label>Address</label>
      <input type="text" name="address" required minlength="5" value="<%= userDoc.address %>">
    </div>

    <div style="display:flex; gap:15px; flex-wrap:wrap;">
      <button type="submit" class="btn">Save Changes</button>
      <a href="/orders/my-orders" class="btn" style="background-color:var(--primary-dark); color:var(--dark-color);">My Orders</a>
      <a href="/user/logout" class="btn" style="background-color:#d90429;">Logout</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
