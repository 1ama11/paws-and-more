<%- include('partials/header', { title: 'Login', active: 'login' }) %>

<div class="container" style="max-width: 500px;">
  <h1>Welcome Back 🐾</h1>
  <p>Login to your Paws &amp; More account.</p>

  <% if (error) { %>
    <div class="error-message" style="display:block; padding:10px; background:#ffe4e4; border-radius:6px; margin-bottom:15px;">
      <%= error %>
    </div>
  <% } %>

  <form action="/user/login" method="POST" class="adoption-form">
    <div class="form-group">
      <label>Email Address</label>
      <input type="email" name="email" required placeholder="you@example.com">
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" required placeholder="Your password">
    </div>

    <div style="display:flex; gap:15px; align-items:center; flex-wrap:wrap;">
      <button type="submit" class="btn">Login</button>
      <span>No account? <a href="/user/signup">Sign Up</a></span>
    </div>
  </form>
</div>

<%- include('partials/footer') %>