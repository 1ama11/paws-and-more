<%- include('partials/header', { title: 'About', active: 'about' }) %>

<!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-tag">About Us</span>
      <h1>We're Pet Lovers,<br>Just Like You 🐾</h1>
      <p>Paws &amp; More was built by pet owners who wanted better — better products, better care, and a better chance for every cat and dog to find a loving home.</p>
      <div class="hero-buttons">
        <a href="/adoption" class="btn btn--primary">Adopt a Pet</a>
        <a href="/shop" class="btn btn--outline">Visit the Shop</a>
      </div>
    </div>
    <div class="hero-paw-bg" aria-hidden="true">💛</div>
  </section>

  <!-- OUR STORY -->
  <section class="section section--light">
    <div class="about-story">
      <div class="about-story-visual">🐈🐕</div>
      <div class="about-story-text" style="animation: fadeUp .7s ease both;">
        <h2>Our Story</h2>
        <p>Paws &amp; More started in 2019 when our founder, Sara, struggled to find quality, affordable products for her two cats and rescue dog — all in one place. Every pet store was either too expensive, too limited, or had no adoption options at all.</p>
        <p>So she built what she wished existed. A cosy, trustworthy place where pet owners could shop for everything their cats and dogs need, and where animals in need could find new families.</p>
        <p>Today, Paws &amp; More has helped over 800 animals find loving homes and serves thousands of pet owners every month. We're proud of every tail wag and every purr that followed.</p>
        <a href="/adoption" class="btn btn--primary">See Our Available Pets →</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section section--primary">
    <div class="section-header">
      <h2>Paws &amp; More by the Numbers</h2>
      <p>Small beginnings, big impact</p>
    </div>
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number">800+</div>
        <div class="stat-label">Pets Successfully Adopted</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">5,000+</div>
        <div class="stat-label">Happy Pet Owners</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">120+</div>
        <div class="stat-label">Products Available</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">4.9★</div>
        <div class="stat-label">Average Customer Rating</div>
      </div>
    </div>
  </section>

  <!-- OUR VALUES -->
  <section class="section section--dark">
    <div class="section-header section-header--light">
      <h2>What We Stand For</h2>
      <p>The values that guide every decision we make</p>
    </div>
    <div class="values-grid">
      <div class="value-card">
        <div class="value-icon">❤️</div>
        <h4>Animal Welfare First</h4>
        <p>Every product we sell and every pet we list for adoption meets our strict welfare standards.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">🌿</div>
        <h4>Natural & Safe</h4>
        <p>We only stock vet-approved, natural products. No harmful chemicals, ever.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">🤝</div>
        <h4>Community Care</h4>
        <p>10% of every adoption fee goes directly to local animal shelters and rescue organisations.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">🔍</div>
        <h4>Full Transparency</h4>
        <p>We're open about where our products come from and how our adoption process works.</p>
      </div>
    </div>
  </section>

  <!-- MEET THE TEAM -->
  <section class="section section--cream">
    <div class="section-header">
      <h2>Meet the Team 👋</h2>
      <p>The people behind Paws &amp; More — all proud pet owners</p>
    </div>
    <div class="team-grid">
      <div class="team-card">
        <div class="team-avatar">👩</div>
        <div class="team-name">Sara El-Amin</div>
        <div class="team-role">Founder & CEO</div>
        <p class="team-bio">Cat mum of two and rescue dog owner. Sara started Paws &amp; More to make pet care simpler and adoption more accessible.</p>
      </div>
      <div class="team-card">
        <div class="team-avatar">👨</div>
        <div class="team-name">Karim Youssef</div>
        <div class="team-role">Head of Adoption</div>
        <p class="team-bio">Karim coordinates all our adoptions and works closely with shelters. He has fostered over 30 cats and dogs over the years.</p>
      </div>
      <div class="team-card">
        <div class="team-avatar">👩‍🦱</div>
        <div class="team-name">Lena Hoffmann</div>
        <div class="team-role">Vet Consultant</div>
        <p class="team-bio">Lena reviews every product we stock and ensures all our animals are healthy, vaccinated, and ready for their forever homes.</p>
      </div>
      <div class="team-card">
        <div class="team-avatar">🧑</div>
        <div class="team-name">Omar Saleh</div>
        <div class="team-role">Customer Experience</div>
        <p class="team-bio">Omar makes sure every customer — human and furry — gets the best experience. Dog dad to a very energetic Labrador named Hazel.</p>
      </div>
    </div>
  </section>

  <!-- CTA STRIP -->
  <section class="section section--dark adoption-banner">
    <div class="adoption-banner-inner">
      <h2>Ready to Make a Difference? 🐾</h2>
      <p>Whether you're shopping for your pet or looking to welcome a new one, Paws &amp; More is here for every step of the journey.</p>
      <div class="hero-buttons">
        <a href="/adoption" class="btn btn--primary">Adopt a Pet</a>
        <a href="/shop" class="btn btn--outline">Shop Now</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->

<%- include('partials/footer') %>
